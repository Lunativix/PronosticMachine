# SQLite local default. PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://sportwise:sportwise@localhost:5432/sportwise
DATABASE_URL=sqlite:///./data/sportwise.db

# External providers. Leave empty to stay on imported historical data.
API_KEY=
ODDS_API_KEY=
DATA_PROVIDER=csv
ODDS_PROVIDER=csv
FIXTURE_PROVIDER=espn
FIXTURE_SYNC_INTERVAL_MINUTES=60

# Optional alert channels. Nothing is sent unless a value is set.
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_URL=

MIN_EDGE=0.04
MIN_EV=0.03
MIN_MODEL_CONFIDENCE=0.55
MIN_HISTORY_MATCHES=5
INITIAL_BANKROLL=1000
MAX_STAKE_PERCENT=0.02
KELLY_FRACTION=0.25
FIXED_STAKE=10
MODEL_RETRAIN_DAYS=7
USE_MARKET_FEATURES_IN_MODEL=false
LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
